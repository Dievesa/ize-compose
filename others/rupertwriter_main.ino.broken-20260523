String getLocalLayoutChar(char us, bool isAlt, int mode) {
    if (isAlt) {
        switch (us) {
            case 'q': case 'Q': return "@";
            case '8': return "[";
            case '9': return "]";
            case '7': return "{";
            case '0': return "}";
            case '-': return "\\";
            case '=': return "~";
            default: return "";
        }
    }

    if (mode == 2 || mode == 3) {
        if (us == 'z') return "y";
        if (us == 'Z') return "Y";
        if (us == 'y') return "z";
        if (us == 'Y') return "Z";
    } else if (mode == 5) {
        switch (us) {
            case 'q': return "a"; case 'Q': return "A";
            case 'a': return "q"; case 'A': return "Q";
            case 'w': return "z"; case 'W': return "Z";
            case 'z': return "w"; case 'Z': return "W";
            case 'm': return ","; case 'M': return "?";
            case ',': return ";"; case '<': return ".";
            case '.': return ":"; case '>': return "/";
            case '/': return "!"; case '?': return "?";
            case ';': return "m"; case ':': return "M";
        }
    }

    return String(us);
}

