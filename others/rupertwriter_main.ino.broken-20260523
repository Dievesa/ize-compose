void moveCursorUp() {
    flushKorean();
    int lineStart = cursorPos;
    while (lineStart > 0 && fullText[lineStart - 1] != '\n') lineStart--;
    if (lineStart == 0) return;

    int column = cursorPos - lineStart;
    int prevLineStart = lineStart - 1;
    while (prevLineStart > 0 && fullText[prevLineStart - 1] != '\n') prevLineStart--;

    int prevLineLength = lineStart - 1 - prevLineStart;
    cursorPos = (column > prevLineLength) ? (lineStart - 1) : (prevLineStart + column);
    needUpdate = true;
}

void moveCursorDown() {
    flushKorean();
    int lineStart = cursorPos;
    while (lineStart > 0 && fullText[lineStart - 1] != '\n') lineStart--;
    int column = cursorPos - lineStart;

    int nextLineStart = cursorPos;
    while (nextLineStart < fullText.length() && fullText[nextLineStart] != '\n') nextLineStart++;
    if (nextLineStart >= fullText.length()) return;
    nextLineStart++;

    int nextLineEnd = nextLineStart;
    while (nextLineEnd < fullText.length() && fullText[nextLineEnd] != '\n') nextLineEnd++;

    int nextLineLength = nextLineEnd - nextLineStart;
    cursorPos = nextLineStart + min(column, nextLineLength);
    needUpdate = true;
}
